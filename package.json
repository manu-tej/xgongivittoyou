{
  "name": "x-long-post",
  "version": "1.0.0",
  "description": "Post long-form content to X/Twitter by automatically creating threads",
  "main": "dist/index.js",
  "bin": {
    "x-post": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
